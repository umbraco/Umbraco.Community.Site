<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Umbraco 19 trial: Umbraco.Mcp.HostedAuth 19 is only on the pre-releases feed for now. -->
    <add key="umbracoprereleases" value="https://www.myget.org/F/umbracoprereleases/api/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="umbracoprereleases">
      <package pattern="Umbraco.Mcp.HostedAuth" />
    </packageSource>
  </packageSourceMapping>

  <activePackageSource>
    <add key="All" value="(Aggregate source)" />
  </activePackageSource>
  
</configuration>
