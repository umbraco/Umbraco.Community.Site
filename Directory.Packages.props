<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets a PackageVersion below also raise a package that only arrives transitively (see OpenTelemetry.Api). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Umbraco -->
    <PackageVersion Include="Umbraco.Cms" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Cms.Core" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="19.0.0-rc1" />
    <!-- Umbraco Cloud & Deploy -->
    <PackageVersion Include="Umbraco.Cloud.Cms" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Cloud.StorageProviders.AzureBlob" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Deploy.OnPrem" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Deploy.Cloud" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Deploy.Infrastructure" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Deploy.Core" Version="19.0.0-rc1" />
    <!-- Umbraco Forms -->
    <PackageVersion Include="Umbraco.Forms" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Forms.Core" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Forms.Core.Providers" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Forms.Web" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Forms.Deploy" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Mcp.HostedAuth" Version="19.0.0-beta.1" />
    <!-- Umbraco AI -->
    <PackageVersion Include="Umbraco.AI" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Agent" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Agent.Copilot.Workspace" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Amazon" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Anthropic" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Google" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.MicrosoftFoundry" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.OpenAI" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Prompt" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Search" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.TypeSafe" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Search.Db.Sqlite" Version="19.0.0-rc.1" />
    <PackageVersion Include="Umbraco.AI.Search.Db.SqlServer" Version="19.0.0-rc.1" />
    <!-- Umbraco Automate -->
    <PackageVersion Include="Umbraco.Automate" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Automate.Core" Version="19.0.0-rc1" />
    <PackageVersion Include="Umbraco.Deploy.Automate" Version="19.0.0-rc1" />
    <!-- Umbraco Community Packages -->
    <PackageVersion Include="Umbraco.Community.BlockPreview" Version="7.0.0-rc1" />
    <PackageVersion Include="Umbraco.Community.Contentment" Version="8.0.0-alpha001" />
    <!-- Microsoft -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="FluentAssertions" Version="[7.2.2,8.0.0)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <!-- Auth -->
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="11.0.0" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- Other -->
    <PackageVersion Include="Joonasw.AspNetCore.SecurityHeaders" Version="6.0.0" />
    <!-- Transitive only (Umbraco.Automate.Core > WorkflowCore asks for 1.1.0, which has GHSA-g94r-2vxg-569j). -->
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Schema.NET" Version="13.0.0" />
  </ItemGroup>
</Project>