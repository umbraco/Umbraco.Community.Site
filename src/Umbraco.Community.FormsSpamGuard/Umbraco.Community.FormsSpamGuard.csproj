<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <!-- Required for an RCL to compile MVC views (.cshtml); without it the field view is silently not built. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.FormsSpamGuard</PackageId>
    <Product>Umbraco.Community.FormsSpamGuard</Product>
    <Title>Umbraco.Community.FormsSpamGuard</Title>
    <Description>A multi-signal anti-spam field type for Umbraco Forms.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Forms.Core" />
    <PackageReference Include="Umbraco.Forms.Core.Providers" />
    <PackageReference Include="Umbraco.Forms.Web" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>
</Project>
