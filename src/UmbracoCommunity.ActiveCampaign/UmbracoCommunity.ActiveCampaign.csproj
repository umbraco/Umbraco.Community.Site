<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>UmbracoCommunity.ActiveCampaign</PackageId>
    <Product>UmbracoCommunity.ActiveCampaign</Product>
    <Title>UmbracoCommunity.ActiveCampaign</Title>
    <Description>Umbraco Forms workflow that subscribes form submitters to an ActiveCampaign list via the ActiveCampaign v3 REST API.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Umbraco.Forms.Core" />
    <PackageReference Include="Umbraco.Forms.Core.Providers" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UmbracoCommunity.ActiveCampaign.Tests" />
  </ItemGroup>
</Project>
