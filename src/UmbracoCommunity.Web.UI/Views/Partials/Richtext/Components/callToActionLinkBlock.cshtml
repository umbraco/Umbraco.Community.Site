@using Umbraco.Cms.Core.Models.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<RichTextBlockItem<CallToActionLinkBlock, SettingsCallToActionLinkBlock>>

@if (Model?.Content?.CallToActionLink != null)
{
    <div class="cta-link">
        <partial name="~/Views/Partials/Components/CallToActionLink.cshtml" model="@((Model.Content.CallToActionLink, Model.Content.CallToActionLinkText, Model.Settings?.ButtonColour))" />
    </div>
}
