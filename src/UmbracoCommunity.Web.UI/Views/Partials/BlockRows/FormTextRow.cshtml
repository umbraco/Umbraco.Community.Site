@using UmbracoCommunity.Web.Models.ViewModels.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridRow>

@*
    A form beside a text block. Reached when BlockGridRow.GetAlias() produces "formtextRow" — i.e. a row holding
    both a Form block and a Text block, which is only possible once the Form block allows a column span below 12.

    The form itself is delegated to Views/Partials/Blocks/FormBlock.cshtml rather than reproduced here: it handles
    the stepped-form wrapper, the block id and the empty-form guard, and a second copy of that would drift.
    Text is rendered inline, matching ImageTextRow and TextRow.
*@

@{
    bool bgIsDark = Model.HasBg && Model.BackgroundColour.IsDark();
}

<div class="dc-image-and-text-block vertical-text-position-center @(Model.HasBg ? "has-bg" : string.Empty) @(bgIsDark ? "bg-dark" : string.Empty)" id="@Model.IdHash">
    @if (Model.HasBg)
    {
        <style asp-add-nonce="true">
            #@Model.IdHash {
                background-color: @Model.BackgroundColour;
            }
        </style>
    }
    @foreach (var block in Model.Blocks)
    {
        if (block.Content.ContentType.Alias == FormBlock.ModelTypeAlias)
        {
            <div class="dc-image-and-text-block__content-container">
                <partial name="~/Views/Partials/Blocks/FormBlock.cshtml" model="block" />
            </div>
        }
        if (block.Content.ContentType.Alias == TextBlock.ModelTypeAlias)
        {
            var typedBlock = block.Content as TextBlock;
            <div class="dc-image-and-text-block__content-container">
                <div class="dc-image-and-text-block__content">
                    @Html.Raw(typedBlock?.Text?.ToHtmlString())
                </div>
            </div>
        }
    }
</div>
