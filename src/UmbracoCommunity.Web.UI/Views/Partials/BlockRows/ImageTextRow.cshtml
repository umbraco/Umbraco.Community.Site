@using UmbracoCommunity.Web.Models.ViewModels.Blocks
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<BlockGridRow>

@{
    bool bgIsDark = Model.HasBg && Model.BackgroundColour.IsDark();
}

<div class="dc-image-and-text-block vertical-text-position-center @(Model.HasBg ? "has-bg" : string.Empty) @(bgIsDark ? "bg-dark" : string.Empty)" id="@Model.IdHash">
    @if (Model.HasBg)
    {
        <style asp-add-nonce="true">
            #@Model.IdHash {
                background-color: @Model.BackgroundColour;
            }
        </style>
    }
    @foreach (var block in Model.Blocks)
    {
        if (block.Content.ContentType.Alias == ImageBlock.ModelTypeAlias)
        {
            var typedBlock = block.Content as ImageBlock;
            if (typedBlock?.Image != null) {
                bool hasCaption = !string.IsNullOrWhiteSpace(typedBlock.ImageCaption);
                var archClass = (block.Settings as SettingsImageBlock)?.ImageHasArchTop == true ? "is-arch" : null;
                <div class="dc-image-and-text-block__image-container" style="--row-span: @block.ColumnSpan">
                    @if (hasCaption)
                    {
                        <figure>
                            <img srcset="@typedBlock.Image.GetCropUrl("mobile") 386w, @typedBlock.Image.GetCropUrl("desktop") 906w"
                                sizes="(max-width: 400px) 386px, 906px"
                                src="@typedBlock.Image.GetCropUrl("desktop")" alt="@typedBlock.AltText" class="@archClass"
                                width="@typedBlock.Image.GetCropSize("mobile")?.Width" height="@typedBlock.Image.GetCropSize("mobile")?.Height" style="@typedBlock.Image.GetCropRatioStyle()"
                                loading="lazy" />
                            <figcaption>@typedBlock.ImageCaption</figcaption>
                        </figure>
                    }
                    else
                    {
                        <img srcset="@typedBlock.Image.GetCropUrl("mobile") 386w, @typedBlock.Image.GetCropUrl("desktop") 906w"
                            sizes="(max-width: 400px) 386px, 906px"
                            src="@typedBlock.Image.GetCropUrl("desktop")" alt="@typedBlock.AltText" class="@archClass"
                            width="@typedBlock.Image.GetCropSize("mobile")?.Width" height="@typedBlock.Image.GetCropSize("mobile")?.Height" style="@typedBlock.Image.GetCropRatioStyle()"
                            loading="lazy" />
                    }
                </div>
            }
        }
        if (block.Content.ContentType.Alias == TextBlock.ModelTypeAlias)
        {
            var typedBlock = block.Content as TextBlock;
            <div class="dc-image-and-text-block__content-container" style="--row-span: @block.ColumnSpan">
                <div class="dc-image-and-text-block__content">
                    @Html.Raw(typedBlock?.Text?.ToHtmlString())
                </div>
            </div>
        }
    }
</div>