@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<FormBlock, SettingsFormBlock>>

@if (!Model.Content.Form.HasValue)
{
    return;
}

<div class="dc-form-block @Model.Content.IntroLayoutClass(Model.Settings)" id="@(Model.Settings?.BlockId != null ? Model.Settings?.BlockId : string.Empty)">
    <partial name="~/Views/Partials/Components/BlockIntro.cshtml" model="Model.Content" />

    <div class="block-body">
        <div class="dc-text-block">
            @{
                ViewData.TemplateInfo.HtmlFieldPrefix = "";
                var isStepped = Model.Settings?.EnableSteppedForm == true;
            }
            @if (isStepped)
            {
                <dc-form-steps>
                    <umb-forms-render form-id="@Model.Content.Form.Value" />
                </dc-form-steps>
            }
            else
            {
                <umb-forms-render form-id="@Model.Content.Form.Value" />
            }
        </div>
    </div>
</div>