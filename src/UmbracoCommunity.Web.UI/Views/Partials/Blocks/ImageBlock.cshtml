@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockGridItem<ImageBlock, SettingsImageBlock>>
@{
    var cols = Model.GridColumns ?? 12;
    var imgWidth = 1360d * (Model.ColumnSpan / (double)cols);
    var imgIsCircle = Model.Settings?.ImageIsCircular ?? false;
    var cropWidth = (int)Math.Round(imgWidth);
    var aspectRatio = Model.Content.Image.GetAspectRatioStyle();
    var attrHeight = Model.Content.Image.GetScaledHeight(386);
}

@if (Model.Content.Image is not null)
{
    bool hasBg = Model.Settings.HasBg();
    bool hasCaption = !string.IsNullOrWhiteSpace(Model.Content.ImageCaption);

    <div class="dc-image-block @(hasBg ? "has-bg" : "")" id="@Model.Content.IdHash">
        @if (hasBg)
        {
            <style asp-add-nonce="true">
                #@Model.Content.IdHash {
                    --block-background-color: @Model.Settings?.BackgroundColour?.Color;
                }
            </style>
        }

        @if (hasCaption)
        {
            <figure>
                <div class="dc-image-wrapper">
                    <img src="@Model.Content.Image.GetCropUrl(width: cropWidth)" alt="@Model.Content.AltText" class="dc-image @(imgIsCircle ? "is-circle" : "")" width="386" height="@attrHeight" style="@aspectRatio" loading="lazy" />
                </div>
                <figcaption>@Model.Content.ImageCaption</figcaption>
            </figure>
        }
        else
        {
            <div class="dc-image-wrapper">
                <img src="@Model.Content.Image.GetCropUrl(width: cropWidth)" alt="@Model.Content.AltText" class="dc-image @(imgIsCircle ? "is-circle" : "")" width="386" height="@attrHeight" style="@aspectRatio" loading="lazy" />
            </div>
        }
    </div>
}