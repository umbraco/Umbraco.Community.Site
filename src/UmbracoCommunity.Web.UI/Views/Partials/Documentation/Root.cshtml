@using System.Text.Json
@using UmbracoCommunity.Web.Models.Pages.Documentation
@using UmbracoCommunity.Web.Services.Documentation
@using UmbracoCommunity.Web.ViewModelBuilders.Pages
@model DocumentationPageViewModel

@{
    // Tags that name an actual technology/tool/spec, as opposed to a structural or
    // discipline label (e.g. "primer", "architecture", "performance"). Used only to
    // pick which tags surface in the quick-start box — the explorer's own "add a tag"
    // list below is unfiltered, since narrowing by any real tag is useful there.
    var technologyTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        "vite", "lit", "postcss", "css", "svg", "razor", "tag-helper", "web-components",
        "examine", "lucene", "csp", "oauth", "github", "swagger", "ef-core", "sessionize",
        "schema-org", "forms", "hmr", "api", "block-editor", "mutation-observer",
        "intersection-observer", "umbraco-cloud", "clipboard",
    };
}

@functions {
    void RenderArticleCard(DocumentationArticle article, string groupSlug, string pillLabel, bool showTags = true)
    {
        var url = DocumentationPageViewModelBuilder.ComposeUrl(Model.DocRootUrl, article.PathSegments);
        <a class="documentation-article-card documentation-article-card--@groupSlug" href="@url">
            <div class="documentation-article-card__pill">@pillLabel</div>
            <h3 class="documentation-article-card__title">@article.Title</h3>
            @if (!string.IsNullOrWhiteSpace(article.Excerpt))
            {
                <p class="documentation-article-card__excerpt">@article.Excerpt</p>
            }
            @if (showTags && article.Tags.Count > 0)
            {
                <ul class="documentation-article-card__tags" aria-label="Tags">
                    @foreach (var tag in article.Tags)
                    {
                        <li class="documentation-article-card__tag">@tag</li>
                    }
                </ul>
            }
        </a>
    }
}

@if (!Model.Index.HasContent)
{
    <header class="documentation__header">
        <h1>@DocumentationService.RootDisplayTitle</h1>
    </header>
    <p class="documentation__empty">No documentation has been published yet.</p>
    return;
}

@{
    var primersSection = Model.Index.Sections.FirstOrDefault(s => string.Equals(s.Slug, "primers", StringComparison.OrdinalIgnoreCase));
    var gettingStarted = primersSection?.Articles.FirstOrDefault(a => string.Equals(a.Slug, "getting-started", StringComparison.OrdinalIgnoreCase));

    // Flat (article, type-slug) pairs — "type" is Primers/Foundations/Refinements, used
    // for the card pill colour, the explorer's type filter, and picking quick-start tags.
    var typedArticles = new List<(DocumentationArticle Article, string Type)>();
    foreach (var topNode in Model.Index.Sections)
    {
        if (topNode.Subsections.Count > 0)
        {
            foreach (var sub in topNode.Subsections)
            {
                typedArticles.AddRange(sub.Articles.Select(a => (a, sub.Slug)));
            }
        }
        else
        {
            foreach (var article in topNode.Articles)
            {
                if (gettingStarted is not null && article.Slug == gettingStarted.Slug) continue;
                typedArticles.Add((article, topNode.Slug));
            }
        }
    }

    var topTechTags = typedArticles
        .SelectMany(x => x.Article.Tags)
        .Where(t => technologyTags.Contains(t))
        .GroupBy(t => t, StringComparer.OrdinalIgnoreCase)
        .OrderByDescending(g => g.Count())
        .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
        .Take(10)
        .Select(g => g.Key)
        .ToList();

    var explorerData = typedArticles.Select(x => new
    {
        title = x.Article.Title,
        excerpt = x.Article.Excerpt,
        url = DocumentationPageViewModelBuilder.ComposeUrl(Model.DocRootUrl, x.Article.PathSegments),
        tags = x.Article.Tags,
        type = x.Type,
    });
    var explorerJson = JsonSerializer.Serialize(explorerData);
}

<header class="documentation__header">
    <h1>@DocumentationService.RootDisplayTitle</h1>
</header>

@if (gettingStarted is not null)
{
    <section id="documentation-quickstart" class="documentation-quickstart" aria-label="Quick start">
        <div class="documentation-quickstart__header">
            <h2 class="documentation-quickstart__title">Quick start</h2>
            <dc-quickstart-dismiss target="documentation-quickstart"></dc-quickstart-dismiss>
        </div>
        <div class="documentation-quickstart__cols">
            <div>
                @{ RenderArticleCard(gettingStarted, "primers", "Primers", showTags: false); }
            </div>
            @if (topTechTags.Count > 0)
            {
                <div class="documentation-quickstart__col--tags">
                    <p class="documentation-quickstart__label">Explore by topic</p>
                    <ul class="documentation-quickstart__tag-list">
                        @foreach (var tag in topTechTags)
                        {
                            <li>
                                <a class="documentation-quickstart__tag" href="@(Model.DocRootUrl + "/?tags=" + Uri.EscapeDataString(tag))">#@tag</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
}

<script type="application/json" id="documentation-explorer-data">@Html.Raw(explorerJson)</script>
<dc-doc-explorer></dc-doc-explorer>
