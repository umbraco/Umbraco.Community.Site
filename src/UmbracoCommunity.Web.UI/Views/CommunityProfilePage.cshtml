@inherits UmbracoViewPage<CommunityProfilePageViewModel>
@using UmbracoCommunity.Web.Features.Members
@using UmbracoCommunity.Web.Features.Profiles
@using UmbracoCommunity.Web.Features.Profiles.Models
@using UmbracoCommunity.Web.Models.Pages
@using UmbracoCommunity.Web.Utilities
@{
    Layout = "Layout.cshtml";
    var profile = Model.Profile;
}

@functions {
    static string Date(DateTimeOffset? value) => value?.ToString("d MMM yyyy") ?? string.Empty;

    // Marks a section or item the member hid, on a DevRel view that shows everything.
    void HiddenLabel(string group, string? activityId = null)
    {
        if (Model.IsMarkedHidden(group, activityId))
        {
            <span class="community-profile__hidden-label">Hidden by member</span>
        }
    }
}

@if (profile is null)
{
    var returnUrl = (Context.Request.Path + Context.Request.QueryString).ToString();

    // Reuses the real profile hero's own markup/classes — an empty silhouette avatar and
    // ghost lines standing in for headline/bio — so a visitor sees the shape of the profile
    // they'd be moving into, rather than a bare "not found" message.
    <article class="community-profile community-profile--claim">
        <header class="community-profile__hero">
            <div class="community-profile__hero-inner">
                <div class="community-profile__portrait">
                    <div class="community-profile__avatar community-profile__avatar--empty" aria-hidden="true">
                        <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </div>
                </div>

                <div class="community-profile__identity">
                    <h1 class="community-profile__name">@@@Model.Handle</h1>

                    <div class="community-profile__ghost-lines" aria-hidden="true">
                        <span class="community-profile__ghost-line community-profile__ghost-line--headline"></span>
                        <span class="community-profile__ghost-line"></span>
                        <span class="community-profile__ghost-line community-profile__ghost-line--short"></span>
                    </div>

                    <div class="community-profile__claim">
                        <p class="community-profile__claim-text">
                            This profile is still waiting for @@@Model.Handle to move in — headline, bio,
                            talks, packages, and more will all show up here once it's claimed.
                        </p>
                        @using (Html.BeginUmbracoForm("ExternalLogin", "UmbExternalLogin"))
                        {
                            <input type="hidden" name="provider" value="@GitHubExternalLoginProviderOptions.SchemeName" />
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit" class="btn is-white member-signin__btn">
                                <partial name="~/Views/Partials/Icons/GitHub.cshtml" />
                                Sign in with GitHub to claim this profile
                            </button>
                        }
                    </div>
                </div>
            </div>
        </header>
    </article>
}
else
{
    var identity = profile.Identity;

    // "Featured" strip, shown above the fold. The items the member pinned (FeaturedItems, see
    // ProfileDisplay) when there are any; otherwise the most recent item of each type (each
    // list is assumed newest-first).
    // Stock placeholder images (Pexels, CSP-allowed) for the blog/video cards in the
    // prototype. Real cover art / YouTube thumbnails arrive with the live data.
    const string blogStockImage = "https://images.pexels.com/photos/7059/man-people-space-desk.jpg?auto=compress&cs=tinysrgb&w=600";
    const string videoStockImage = "https://images.pexels.com/photos/8852720/pexels-photo-8852720.jpeg?auto=compress&cs=tinysrgb&w=600";
    const string talkStockImage = "https://images.pexels.com/photos/9275222/pexels-photo-9275222.jpeg?auto=compress&cs=tinysrgb&w=600";

    // Package cards get an abstract Umbraco-colours image (a data: SVG, CSP-allowed)
    // rather than a photo — packages don't have natural cover art.
    var packageSvg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 180'>"
        + "<rect width='320' height='180' fill='#283a97'/>"
        + "<circle cx='70' cy='55' r='85' fill='#f79c37' opacity='0.85'/>"
        + "<circle cx='250' cy='140' r='100' fill='#fad634' opacity='0.5'/>"
        + "<circle cx='275' cy='45' r='55' fill='#f5c1bc' opacity='0.75'/>"
        + "</svg>";
    var packageStockImage = "data:image/svg+xml," + Uri.EscapeDataString(packageSvg);

    var highlights = new List<(string Kind, string Key, string Title, string? Meta, string? Desc, IReadOnlyList<string>? Chips, string? Url, string? Thumb, string? Reason, string? Group, string? ActivityId)>();
    if (profile.FeaturedItems.Count > 0)
    {
        // The member pinned these themselves, in this order, with their own note on why.
        foreach (var item in profile.FeaturedItems)
        {
            var (kind, key, thumb) = item.Group switch
            {
                PlatformActivityGroups.Blog => ("Blog post", "blog", blogStockImage),
                PlatformActivityGroups.Videos => ("Video", "video", videoStockImage),
                PlatformActivityGroups.Packages => ("Package", "package", packageStockImage),
                PlatformActivityGroups.Forum => ("Forum post", "forum", (string?)null),
                PlatformActivityGroups.Meetups => ("Meet-up", "meetup", null),
                PlatformActivityGroups.Other => (item.Source ?? "Activity", "other", null),
                _ => ("Social post", "social", null),
            };
            var meta = string.Join(" · ", new[] { item.Date is null ? null : Date(item.Date), item.Source }.Where(s => !string.IsNullOrEmpty(s)));
            highlights.Add((kind, key, item.Title, meta, item.Description, null, item.Url, thumb, item.Reason, item.Group, item.ActivityId));
        }
    }
    else
    {
        if (profile.Packages.Count > 0)
        {
            var p = profile.Packages[0];
            highlights.Add(("Package", "package", p.Name, null, p.Description, p.Versions, p.Url, packageStockImage, null, PlatformActivityGroups.Packages, p.ActivityId));
        }
        if (profile.Talks.Count > 0)
        {
            var t = profile.Talks[0];
            var meta = string.Join(" · ", new[] { t.EventName, t.Date is null ? null : Date(t.Date) }.Where(s => !string.IsNullOrEmpty(s)));
            highlights.Add(("Talk", "talk", t.Title, meta, t.Description, null, t.Url, talkStockImage, null, null, null));
        }
        if (profile.BlogPosts.Count > 0)
        {
            var b = profile.BlogPosts[0];
            var meta = string.Join(" · ", new[] { Date(b.PublishedAt), b.Source }.Where(s => !string.IsNullOrEmpty(s)));
            highlights.Add(("Blog post", "blog", b.Title, meta, b.Excerpt, null, b.Url, blogStockImage, null, PlatformActivityGroups.Blog, b.ActivityId));
        }
        if (profile.Videos.Count > 0)
        {
            var v = profile.Videos[0];
            highlights.Add(("Video", "video", v.Title, v.PublishedAt is null ? null : Date(v.PublishedAt), v.Description, null, v.Url, videoStockImage, null, PlatformActivityGroups.Videos, v.ActivityId));
        }
    }

    <article class="community-profile">
        @if (Model.ShowDevRelBanner)
        {
            <div class="community-profile__devrel-banner" role="status">
                <div class="community-profile__devrel-banner-inner">
                    <p class="community-profile__devrel-banner-title">DevRel view — this page is not public.</p>
                    @if (Model.IsHiddenFromPublic)
                    {
                        <p class="community-profile__devrel-banner-text">This member has hidden their profile. Only DevRel can see it.</p>
                    }
                    @if (Model.IsGated)
                    {
                        <p class="community-profile__devrel-banner-text">The activity sections are not public on this site yet.</p>
                    }
                    @if (Model.IsShowingEverything)
                    {
                        <p class="community-profile__devrel-banner-text">Showing everything, including items the member hid.</p>
                        <a class="btn is-white community-profile__devrel-banner-action" href="@Model.DevRelPublicViewUrl">Show what the public sees</a>
                    }
                    else
                    {
                        <p class="community-profile__devrel-banner-text">Showing what the public sees.</p>
                        <a class="btn is-white community-profile__devrel-banner-action" href="@Model.DevRelShowEverythingUrl">Show everything, including hidden items</a>
                    }
                </div>
            </div>
        }
        @if (Model.IsHiddenPreview)
        {
            <dc-profile-hidden-banner account-url="@Model.AccountPageUrl"></dc-profile-hidden-banner>
        }
        <header class="community-profile__hero">
            <div class="community-profile__hero-inner">
                <div class="community-profile__portrait">
                    @if (!string.IsNullOrEmpty(identity.AvatarUrl))
                    {
                        <img class="community-profile__avatar@(identity.IsCurrentMvp ? " community-profile__avatar--mvp" : "")"
                             src="@identity.AvatarUrl"
                             alt="@identity.DisplayName"
                             width="170" height="170" loading="eager" />
                    }
                    @if (identity.IsCurrentMvp)
                    {
                        <span class="community-profile__mvp-badge" role="img" aria-label="Umbraco MVP">MVP</span>
                    }
                </div>

                <div class="community-profile__identity">
                    <h1 class="community-profile__name">
                        @identity.DisplayName
                        @if (!string.IsNullOrEmpty(identity.Pronouns))
                        {
                            <span class="community-profile__pronouns">@identity.Pronouns</span>
                        }
                    </h1>

                    @if (identity.IsMvp && identity.MvpYears.Count > 0)
                    {
                        var yearsText = string.Join(", ", identity.MvpYears);
                        <div class="community-profile__mvp-pill" role="group" tabindex="0" aria-label="Umbraco MVP @yearsText">
                            <span class="community-profile__mvp-pill-label">MVP × @identity.MvpYears.Count</span>
                            <ul class="community-profile__mvp-years" aria-label="Umbraco MVP years">
                                @foreach (var year in identity.MvpYears)
                                {
                                    <li>@year</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(identity.Headline))
                    {
                        <p class="community-profile__headline">@identity.Headline</p>
                    }

                    @if (!string.IsNullOrEmpty(identity.Bio))
                    {
                        <p class="community-profile__bio">@identity.Bio</p>
                    }

                    @if (!string.IsNullOrEmpty(identity.Location))
                    {
                        <ul class="community-profile__meta">
                            <li class="community-profile__location">@identity.Location</li>
                        </ul>
                    }

                    @if (identity.SocialLinks.Count > 0)
                    {
                        <ul class="community-profile__socials">
                            @foreach (var link in identity.SocialLinks)
                            {
                                <li>
                                    <a class="no-link-animation" href="@link.Url" rel="me noopener" target="_blank">
                                        @if (!string.IsNullOrEmpty(link.FaviconUrl))
                                        {
                                            <img class="community-profile__social-favicon" src="@link.FaviconUrl" alt="" width="16" height="16" loading="lazy" />
                                        }
                                        @link.Platform
                                    </a>
                                    @if (Model.IsMarkedHidden(link))
                                    {
                                        <span class="community-profile__hidden-label">Hidden by member</span>
                                    }
                                </li>
                            }
                        </ul>
                    }

                    @if (Model.IsOwnProfile && !string.IsNullOrEmpty(Model.AccountPageUrl))
                    {
                        <p class="community-profile__edit">
                            <a class="btn is-transparent" href="@Model.AccountPageUrl">Edit profile</a>
                        </p>
                    }
                </div>
            </div>
        </header>

        @if (profile.Badges.Count > 0)
        {
            <section class="community-profile__badges-bar" aria-label="Badges">
                <ul class="community-profile__badges">
                    @foreach (var badge in profile.Badges)
                    {
                        <li class="community-profile__award" title="@badge.Description">
                            @if (!string.IsNullOrEmpty(badge.IconUrl))
                            {
                                <img class="community-profile__award-icon" src="@badge.IconUrl" alt="" loading="lazy" width="40" height="40" />
                            }
                            <span class="community-profile__award-name">@badge.Name</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (highlights.Count > 0)
        {
            <section class="community-profile__latest" aria-label="Featured">
                <h2 class="community-profile__latest-title">Featured</h2>
                <ul class="community-profile__highlights">
                    @foreach (var highlight in highlights)
                    {
                        <li class="community-profile__highlight">
                            @if (!string.IsNullOrEmpty(highlight.Thumb))
                            {
                                <a class="community-profile__highlight-media" href="@highlight.Url" target="_blank" rel="noopener">
                                    <img src="@highlight.Thumb" alt="" loading="lazy" />
                                    @if (highlight.Key == "video")
                                    {
                                        <span class="community-profile__play" aria-hidden="true">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="8 5 19 12 8 19 8 5" /></svg>
                                        </span>
                                    }
                                </a>
                            }
                            <span class="community-profile__highlight-kind">
                                @await Html.PartialAsync("~/Views/Partials/Profiles/_KindIcon.cshtml", highlight.Key)
                                @highlight.Kind
                            </span>
                            @if (highlight.Group != null)
                            {
                                HiddenLabel(highlight.Group, highlight.ActivityId);
                            }
                            <a class="community-profile__highlight-title" href="@highlight.Url" target="_blank" rel="noopener">@highlight.Title</a>
                            @if (!string.IsNullOrEmpty(highlight.Reason))
                            {
                                <p class="community-profile__highlight-reason">@highlight.Reason</p>
                            }
                            @if (!string.IsNullOrEmpty(highlight.Desc))
                            {
                                <p class="community-profile__highlight-desc">@highlight.Desc</p>
                            }
                            @if (highlight.Chips is { Count: > 0 })
                            {
                                <ul class="community-profile__versions" aria-label="Versions">
                                    @foreach (var chip in highlight.Chips)
                                    {
                                        <li class="community-profile__version">v@(chip)</li>
                                    }
                                </ul>
                            }
                            @if (!string.IsNullOrEmpty(highlight.Meta))
                            {
                                <span class="community-profile__highlight-meta">@highlight.Meta</span>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Model.ActivityGraph is { } graph)
        {
            <section class="community-profile__graph" aria-labelledby="community-profile-graph-title">
                <h2 class="community-profile__section-title" id="community-profile-graph-title">Activity over the last 12 months</h2>
                <div class="community-profile__graph-grid" aria-hidden="true">
                    @foreach (var week in graph.Weeks)
                    {
                        <span class="community-profile__graph-cell community-profile__graph-cell--@week.Level"
                              title="Week of @week.Start.ToString("d MMM yyyy"): @(week.Count == 1 ? "1 item" : $"{week.Count} items")"></span>
                        <span class="community-profile__graph-month">@week.MonthStart</span>
                    }
                </div>
                <ul class="sr-only">
                    @foreach (var month in graph.Months)
                    {
                        <li>@month.Label: @(month.Count switch { 0 => "nothing", 1 => "1 item", _ => $"{month.Count} items" })</li>
                    }
                </ul>
            </section>
        }

        @if (Model.ShowEnrichedSections && Model.Timeline.Count > 0)
        {
            <section class="community-profile__timeline" aria-labelledby="community-profile-timeline-title">
                <h2 class="community-profile__section-title" id="community-profile-timeline-title">Timeline</h2>
                <dc-profile-timeline>
                    @if (Model.TimelineTypes.Count > 1)
                    {
                        // A plain GET form, so the filter also works without JavaScript; <dc-profile-timeline> filters in place
                        // and keeps ?type= in the address. Other query string values (e.g. the DevRel view) are carried along.
                        <form class="community-profile__timeline-filters" method="get" data-timeline-filters>
                            @foreach (var parameter in Context.Request.Query.Where(q => !string.Equals(q.Key, ProfileTimeline.TypeQueryKey, StringComparison.OrdinalIgnoreCase)))
                            {
                                foreach (var value in parameter.Value)
                                {
                                    <input type="hidden" name="@parameter.Key" value="@value" />
                                }
                            }
                            <div class="community-profile__timeline-filter">
                                <label for="community-profile-timeline-type">Type</label>
                                <select id="community-profile-timeline-type" name="@ProfileTimeline.TypeQueryKey" data-timeline-type>
                                    <option value="" selected="@(Model.TimelineType == null)">Everything</option>
                                    @foreach (var type in Model.TimelineTypes)
                                    {
                                        <option value="@type.Key" selected="@(type.Key == Model.TimelineType)">@type.Label</option>
                                    }
                                </select>
                            </div>
                            <button class="btn is-transparent community-profile__timeline-apply" type="submit" data-timeline-apply>Show</button>
                        </form>
                    }
                    <p class="community-profile__timeline-empty" data-timeline-empty role="status" hidden="@Model.TimelineHasShownEntries">Nothing here for this filter.</p>
                    @foreach (var month in Model.Timeline)
                    {
                        <section class="community-profile__timeline-month" data-timeline-month aria-labelledby="community-profile-timeline-@month.Key"
                                 hidden="@(!month.Entries.Any(e => ProfileTimeline.IsShown(e, Model.TimelineType)))">
                            <h3 class="community-profile__timeline-month-title" id="community-profile-timeline-@month.Key">@month.Label</h3>
                            <ol class="community-profile__timeline-list">
                                @foreach (var entry in month.Entries)
                                {
                                    var typeLabel = ProfileDisplay.SectionLabel(entry.Group);
                                    <li class="community-profile__timeline-entry@(entry.Card != null ? " community-profile__timeline-entry--card" : "")"
                                        data-timeline-entry data-type="@entry.Group" hidden="@(!ProfileTimeline.IsShown(entry, Model.TimelineType))">
                                        <span class="community-profile__timeline-icon" title="@typeLabel">
                                            @await Html.PartialAsync("~/Views/Partials/Profiles/_KindIcon.cshtml", entry.IconKey)
                                            <span class="sr-only">@typeLabel:</span>
                                        </span>
                                        <div class="community-profile__timeline-body">
                                            @if (entry.Card is { } card)
                                            {
                                                <a class="community-profile__timeline-card no-link-animation" href="@entry.Url" target="_blank" rel="noopener">
                                                    <img class="community-profile__timeline-card-image" src="@card.ImageUrl" alt="" loading="lazy" />
                                                    <span class="community-profile__timeline-card-text">
                                                        <span class="community-profile__timeline-title">@card.Title</span>
                                                        @if (!string.IsNullOrEmpty(card.Description))
                                                        {
                                                            <span class="community-profile__timeline-desc">@card.Description</span>
                                                        }
                                                    </span>
                                                </a>
                                            }
                                            else if (!string.IsNullOrEmpty(entry.Url))
                                            {
                                                <a class="community-profile__timeline-title" href="@entry.Url" target="_blank" rel="noopener">@entry.Title</a>
                                            }
                                            else
                                            {
                                                <span class="community-profile__timeline-title">@entry.Title</span>
                                            }
                                            <span class="community-profile__timeline-meta">
                                                <time datetime="@entry.Date.UtcDateTime.ToString("yyyy-MM-dd")">@Date(entry.Date)</time>@(string.IsNullOrEmpty(entry.Meta) ? "" : $" · {entry.Meta}")
                                            </span>
                                            @{ HiddenLabel(entry.Group, entry.ActivityId); }
                                        </div>
                                    </li>
                                }
                            </ol>
                        </section>
                    }
                </dc-profile-timeline>
            </section>
        }

        @if (profile.Talks.Count > 0)
        {
            <div class="community-profile__departments">
                <section class="community-profile__section" aria-label="Talks">
                    <h2 class="community-profile__section-title">@await Html.PartialAsync("~/Views/Partials/Profiles/_KindIcon.cshtml", "talk") Talks</h2>
                    <ul class="community-profile__dept-list">
                        @foreach (var talk in profile.Talks)
                        {
                            <li class="community-profile__dept-item">
                                @if (!string.IsNullOrEmpty(talk.Url))
                                {
                                    <a class="community-profile__dept-title" href="@talk.Url" target="_blank" rel="noopener">@talk.Title</a>
                                }
                                else
                                {
                                    <span class="community-profile__dept-title">@talk.Title</span>
                                }
                                @if (!string.IsNullOrEmpty(talk.Description))
                                {
                                    <p class="community-profile__dept-desc">@talk.Description</p>
                                }
                                <span class="community-profile__dept-meta">@talk.EventName@(talk.Date is not null ? $" · {Date(talk.Date)}" : "")</span>
                            </li>
                        }
                    </ul>
                </section>
            </div>
        }
    </article>
}
