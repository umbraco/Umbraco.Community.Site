@using Umbraco.Cms.Core.Models
@using UmbracoCommunity.Web.Helpers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem<VideoShowcaseItem>>

@{
    var video = Model.Content?.Video;
    var thumbnail = video?.Poster?.GetCropUrl(width: 320, height: 180, imageCropMode: ImageCropMode.Crop);
    var accent = Model.Content?.AccentColour?.Color.GetOptionalColor();
}

<div class="video-showcase-item-preview">
    <span class="video-showcase-preview__thumb @(thumbnail == null ? "is-empty" : null)">
        @if (thumbnail != null)
        {
            <img src="@thumbnail" alt="" />
        }
    </span>
    <span class="video-showcase-item-preview__details">
        <span class="video-showcase-item-preview__title">@(string.IsNullOrWhiteSpace(video?.Title) ? "No video picked" : video.Title)</span>
        @if (Model.Content?.Byline != null)
        {
            <span class="video-showcase-item-preview__byline">@Model.Content.Byline</span>
        }
    </span>
    <span class="video-showcase-item-preview__accent" title="@(accent == null ? "Accent from the brand palette" : "Accent " + accent)">
        @if (accent != null)
        {
            <svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="5" fill="@accent" /></svg>
        }
        else
        {
            <span>Auto</span>
        }
    </span>
</div>
