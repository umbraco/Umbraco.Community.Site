@using Joonasw.AspNetCore.SecurityHeaders.Csp
@using UmbracoCommunity.Web.Models.ViewModels.Components

@model MetaTagsViewModel

@inject ICspNonceService nonceService;
@inject IWebHostEnvironment webHostEnvironment;

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, height=device-height, initial-scale=1.0, minimum-scale=1.0">

<meta property="og:title" content="@Model.MetaTitle">
<meta name="twitter:title" content="@Model.MetaTitle">

<meta name="description" content="@Model.MetaDescription" />
<meta property="og:description" content="@Model.MetaDescription">
<meta name="twitter:description" content="@Model.MetaDescription">

<meta property="og:type" content="website">
<meta property="og:site_name" content="@Model.SiteName">
<meta property="og:locale" content="@System.Globalization.CultureInfo.CurrentCulture.Name.Replace("-", "_")">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@("@umbraco")">

@if (Model.HasOpenGraphImageUrl)
{
    <meta property="og:image" content="@Model.OpenGraphImageUrl">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="628">
    <meta name="twitter:image" content="@Model.OpenGraphImageUrl">
}

@if (!string.IsNullOrEmpty(Model.CanonicalUrl))
{
    <link rel="canonical" href="@Model.CanonicalUrl" />
    <meta property="og:url" content="@Model.CanonicalUrl">
}

@if (!string.IsNullOrEmpty(Model.PrevUrl))
{
    <link rel="prev" href="@Model.PrevUrl" />
}

@if (!string.IsNullOrEmpty(Model.NextUrl))
{
    <link rel="next" href="@Model.NextUrl" />
}

<title>@Model.MetaTitle | @Model.SiteName</title>

@if (string.IsNullOrEmpty(Model.Robots) && webHostEnvironment.IsDevelopment())
{
    <meta name="robots" content="noindex, nofollow" />
}
else if (string.IsNullOrEmpty(Model.Robots))
{
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
}
else if (Model.Robots == "noindex, follow")
{
    <meta name="robots" content="noindex, follow" />
}
else if (Model.Robots == "index, nofollow")
{
    <meta name="robots" content="index, nofollow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
}
else if (Model.Robots == "noindex, nofollow")
{
    <meta name="robots" content="noindex, nofollow" />
}

@if (Model.SchemaMarkups.Any())
{
    foreach (var schemaMarkup in Model.SchemaMarkups)
    {
        @*
            Written raw, deliberately. Two reasons:

            No nonce: an ld+json block is data, never executed, so script-src does not apply and a nonce buys
            nothing (it also made the element tag-helper-processed, which is worse — see below).

            Raw tag: written as normal markup, something in the pipeline HTML-encodes the "+" in the type
            attribute, giving type="application/ld&#x2B;json". That is valid HTML and parsers decode it, but it
            is needlessly obscure in a tag whose entire audience is search engines, and the encoder responsible
            was not identifiable — no project tag helper targets a bare <script>, and no assembly contains the
            encoded literal, so it happens at runtime. Emitting the tag raw sidesteps the question entirely.
            schemaMarkup is already HTML-escaped by Schema.NET's ToHtmlEscapedString(), so this adds no risk.
        *@
        @Html.Raw($"<script type=\"application/ld+json\">{schemaMarkup}</script>")
    }
}

@* Google Tag Manager. Must live in a real view — it was moved to _ViewImports.cshtml in 2025-08 and Razor
   silently discards markup in a view-imports document, so GTM stopped loading entirely once this copy was
   removed on 2025-10-28. Do not move it back there.

   data-nonce is not a duplicate of nonce and is not optional. All 14 Custom HTML tags in the container are
   emitted as <script nonce="{{macro}}">, and that macro is a GTM "DOM Element" variable pointing at element
   id "gtmScript", attribute "data-nonce". The nonce attribute cannot serve: when a CSP arrives in a response
   header, browsers blank the nonce *content* attribute once the element is connected and keep the value only
   on the IDL property, so getAttribute("nonce") returns "". Without data-nonce the macro resolves to nothing,
   GTM writes the literal nonce="null", and script-src blocks every Custom HTML tag — e.g. the afterLoadMatomo
   dataLayer push. Renaming the id or dropping the attribute here silently breaks those tags again; the
   container in GTM has to change with it.

   Known cost: that blanking exists to stop a scriptless attacker reading the nonce back out via CSS attribute
   selectors, and a data- attribute is not covered by it — so this deliberately reopens that side channel, and
   style-src carries 'unsafe-inline' so CSS injection is not itself blocked. Accepted because script-src is the
   only nonce-gated directive and img-src/connect-src/font-src are tight allow-lists with no attacker-controlled
   host to exfiltrate to. The better fix is container-side: a GTM Custom JavaScript variable returning
   document.getElementById("gtmScript").nonce reads the IDL property, which is neither blanked nor reachable
   from CSS, and would let this attribute and this paragraph go away. *@
@if (webHostEnvironment.IsProduction())
{
    <script id="gtmScript" data-nonce="@nonceService.GetNonce()" asp-add-nonce="true">(function (w, d, s, l, i) { w[l] = w[l] || []; w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' }); var f = d.getElementsByTagName(s)[0], j = d.createElement(s); j.async = true; j.src = "https://load.sst.umbraco.com/1tsxmrrbeo.js?" + i; f.parentNode.insertBefore(j, f); })(window, document, 'script', 'dataLayer', 'evkn1fvu=aWQ9R1RNLVQ2VEtNVDI%3D&apiKey=f8823aac');</script>
}
