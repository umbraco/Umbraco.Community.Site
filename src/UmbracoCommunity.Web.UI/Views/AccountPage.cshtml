@using UmbracoCommunity.Web.Models.Pages
@using UmbracoCommunity.Web.Utilities
@inherits UmbracoViewPage<AccountPageViewModel>

@{
    Layout = "Layout.cshtml";
}

<div class="account-page-wrapper">
    <article class="account-page">
        <header class="account-page__header">
            <div class="account-page__identity">
                <h1 class="account-page__name">@Model.DisplayName</h1>

                @if (!string.IsNullOrEmpty(Model.GitHubHandle))
                {
                    <p class="account-page__handle">
                        <a href="https://github.com/@Model.GitHubHandle" target="_blank" rel="noopener noreferrer">
                            <partial name="~/Views/Partials/Icons/GitHub.cshtml" />
                            @@@Model.GitHubHandle
                        </a>
                    </p>
                }

                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <p class="account-page__email">@Model.Email</p>
                }
            </div>

            <form method="post" action="/logout" class="account-page__header-logout">
                @Html.AntiForgeryToken()
                <button type="submit" class="link-action">
                    <partial name="~/Views/Partials/Icons/LogOut.cshtml" />
                    Sign out
                </button>
            </form>
        </header>

        @if (Model.OnboardingCompleted)
        {
            <section class="account-page__section">
                <h2>Your public profile</h2>
                <dc-profile-visibility-toggle profile-visible="@Model.IsProfileVisible"
                                              profile-url="@Model.ProfileUrl"></dc-profile-visibility-toggle>
            </section>

            <section class="account-page__section">
                <h2>Your profile details</h2>
                <p class="account-page__section-hint">Your photo, name, headline and bio as they appear on your public profile. Leave a field empty to use what's on your GitHub profile.</p>
                <dc-profile-details-editor avatar-url="@Model.AvatarUrl"
                                           has-custom-avatar="@Model.HasCustomAvatar"
                                           custom-display-name="@Model.CustomDisplayName"
                                           default-display-name="@Model.DefaultDisplayName"
                                           custom-headline="@Model.CustomHeadline"
                                           github-headline="@Model.GitHubHeadline"
                                           custom-bio="@Model.CustomBio"
                                           github-bio="@Model.GitHubBio"
                                           profile-url="@Model.ProfileUrl"></dc-profile-details-editor>
            </section>

            @if (Model.CanChooseProfileDisplay)
            {
                <section class="account-page__section">
                    <h2>What your profile shows</h2>
                    <p class="account-page__section-hint">Choose which activity sections appear on your profile, hide single items, and pin up to three items you're proud of to the top.</p>
                    <dc-profile-display-editor></dc-profile-display-editor>
                </section>
            }

            @if (Model.CanAddActivity)
            {
                <section class="account-page__section">
                    <h2>Add your activity</h2>
                    <p class="account-page__section-hint">Add a blog post, video, package, talk or anything else that isn't on your profile yet. We check each one before it appears.</p>
                    <dc-profile-activity-editor></dc-profile-activity-editor>
                </section>
            }
        }
        else if (!string.IsNullOrEmpty(Model.OnboardingUrl))
        {
            <section class="account-page__section">
                <h2>Your public profile</h2>
                <p class="account-page__section-hint">
                    <a href="@Model.OnboardingUrl">Finish setting up your profile</a> to get a public page the community can find.
                </p>
            </section>
        }

        @if (Model.MvpBadgeYear is { } mvpBadgeYear)
        {
            <section class="account-page__section account-page__mvp-badge" aria-labelledby="mvp-badge-heading">
                <h2 id="mvp-badge-heading">Your Umbraco MVP @mvpBadgeYear badge</h2>
                <div class="account-page__mvp-badge-body">
                    <img class="account-page__mvp-badge-image" src="@Model.MvpBadgeImageUrl" alt="" width="120" height="120" loading="lazy" />
                    <div>
                        <p class="account-page__section-hint">
                            A verifiable Open Badge for your MVP year. The image carries the badge details, so sites that support Open Badges can check it was issued to you. It shows as expired once your @mvpBadgeYear MVP year is over.
                        </p>
                        <p class="account-page__section-hint">
                            To show it on Sessionize, open your profile, choose Edit, go to Badges and upload the PNG.
                        </p>
                        <a class="btn is-blue" href="@Model.MvpBadgeDownloadUrl" download>Download Umbraco MVP @mvpBadgeYear badge (PNG)</a>
                    </div>
                </div>
            </section>
        }

        <section class="account-page__section">
            <h2>Your feeds</h2>
            <p class="account-page__section-hint">Manage the blogs and social profiles that feed your public profile.</p>
            <dc-feed-manager></dc-feed-manager>
        </section>

        @if (Model.CanMatchLinks)
        {
            <section class="account-page__section">
                <h2>Links we found for you</h2>
                <p class="account-page__section-hint">These accounts and feeds look like yours. Add the ones that are, and tell us about any that aren't.</p>
                <dc-link-suggestions></dc-link-suggestions>
            </section>
        }
    </article>
</div>
