@using UmbracoCommunity.Web.Models.Pages
@using UmbracoCommunity.Web.Utilities
@inherits UmbracoViewPage<AccountPageViewModel>

@{
    Layout = "Layout.cshtml";

    // The side menu's panels, in menu order: each has a stable id, which the address's hash selects (/account#timeline).
    // Only the panels this member is offered are listed, on the same conditions as before.
    var showTimeline = Model.OnboardingCompleted && Model.CanChooseProfileDisplay;
    var showAddActivity = Model.OnboardingCompleted && Model.CanAddActivity;
    var showMvpBadge = Model.MvpBadgeYear is not null;
    var showBadges = Model.OnboardingCompleted;

    var panels = new List<(string Id, string Label)> { ("profile", "Profile") };
    if (showTimeline) { panels.Add(("timeline", "Timeline")); }
    if (showAddActivity) { panels.Add(("add-activity", "Add activity")); }
    panels.Add(("feeds", "Feeds & links"));
    if (showBadges) { panels.Add(("badges", "Forum badges")); }
    if (showMvpBadge) { panels.Add(("mvp-badge", "MVP badge")); }
}

@{
    // Under the name in the header: how the member signs in, a link to their public profile and, while it's hidden, who
    // can see it. Only they see this page, so their email shows too.
    Func<object?, IHtmlContent> accountDetails = @<div class="account-page__hero-details">
        <p class="account-page__hero-account">
            @if (!string.IsNullOrEmpty(Model.GitHubHandle))
            {
                <a class="account-page__handle" href="https://github.com/@Model.GitHubHandle" target="_blank" rel="noopener noreferrer">
                    <partial name="~/Views/Partials/Icons/GitHub.cshtml" />
                    @@@Model.GitHubHandle
                    <span class="sr-only">on GitHub (opens in a new tab)</span>
                </a>
            }
            @if (!string.IsNullOrEmpty(Model.Email))
            {
                <span class="account-page__email">@Model.Email</span>
            }
        </p>

        @if (Model.OnboardingCompleted)
        {
            <p class="account-page__hero-note">This is the top of your public profile. Changes you make here, such as links you add, show on it straight away.</p>
            <p class="account-page__hero-hidden" data-profile-hero="hidden-note" hidden="@Model.IsProfileVisible">
                Your profile is hidden: only you can see it. <a href="#profile">Show it to everyone from Profile</a>.
            </p>
            @if (!string.IsNullOrEmpty(Model.ProfileUrl))
            {
                <p class="account-page__hero-actions">
                    <a class="btn is-transparent" href="@Model.ProfileUrl" target="_blank" rel="noopener">
                        View public profile
                        <partial name="~/Views/Partials/Icons/ExternalLink.cshtml" />
                        <span class="sr-only">(opens in a new tab)</span>
                    </a>
                </p>
            }
        }
    </div>;
}

@* The header previews the public profile's hero and follows edits made below (dc-account-profile-hero). *@
<div class="account-page__profile">
    <dc-account-profile-hero>
        <partial name="~/Views/Partials/Profiles/_ProfileHero.cshtml" model="@(new ProfileHeroViewModel { Identity = Model.ProfileIdentity, Badges = Model.ProfileBadges, Live = true, Footer = accountDetails })" />
    </dc-account-profile-hero>
</div>

<div class="account-page-wrapper">
    <article class="account-page">
        @* Without JavaScript every panel shows and the menu links jump to them; <dc-account-nav> then shows one at a time. *@
        <dc-account-nav class="account-page__body">
            <nav class="account-page__nav" aria-label="Account">
                <ul class="account-page__nav-list">
                    @foreach (var panel in panels)
                    {
                        <li>
                            <a class="account-page__nav-link no-link-animation" href="#@panel.Id" data-account-nav-link>@panel.Label</a>
                        </li>
                    }
                </ul>

                <form method="post" action="/logout" class="account-page__nav-logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="link-action">
                        <partial name="~/Views/Partials/Icons/LogOut.cshtml" />
                        Sign out
                    </button>
                </form>
            </nav>

            <div class="account-page__panels">
                <section id="profile" class="account-page__panel" data-account-panel aria-labelledby="account-panel-profile-title">
                    <h2 id="account-panel-profile-title" class="account-page__panel-title" tabindex="-1">Profile</h2>

                    @if (Model.OnboardingCompleted)
                    {
                        <section class="account-page__section">
                            <h3 class="account-page__section-title">Your public profile</h3>
                            <dc-profile-visibility-toggle profile-visible="@Model.IsProfileVisible"
                                                          profile-url="@Model.ProfileUrl"></dc-profile-visibility-toggle>
                        </section>

                        <section class="account-page__section">
                            <h3 class="account-page__section-title">Your profile details</h3>
                            <p class="account-page__section-hint">Your photo, name, headline and bio as they appear on your public profile. Leave a field empty to use what's on your GitHub profile.</p>
                            <dc-profile-details-editor avatar-url="@Model.AvatarUrl"
                                                       has-custom-avatar="@Model.HasCustomAvatar"
                                                       custom-display-name="@Model.CustomDisplayName"
                                                       default-display-name="@Model.DefaultDisplayName"
                                                       custom-headline="@Model.CustomHeadline"
                                                       github-headline="@Model.GitHubHeadline"
                                                       custom-bio="@Model.CustomBio"
                                                       github-bio="@Model.GitHubBio"
                                                       profile-url="@Model.ProfileUrl"></dc-profile-details-editor>
                        </section>
                    }
                    else
                    {
                        @* Profile setup runs automatically on sign-in; it failed this time and is retried on the next page load. *@
                        <p class="account-page__section-hint">
                            We couldn't finish setting up your profile. Reload this page in a moment to try again.
                        </p>
                    }
                </section>

                @if (showTimeline)
                {
                    <section id="timeline" class="account-page__panel" data-account-panel aria-labelledby="account-panel-timeline-title">
                        <h2 id="account-panel-timeline-title" class="account-page__panel-title" tabindex="-1">Timeline</h2>
                        <p class="account-page__section-hint">Choose which activity sections appear on your profile, hide single items, and pin up to three items you're proud of to the top.</p>
                        <dc-profile-display-editor></dc-profile-display-editor>
                    </section>
                }

                @if (showAddActivity)
                {
                    <section id="add-activity" class="account-page__panel" data-account-panel aria-labelledby="account-panel-add-activity-title">
                        <h2 id="account-panel-add-activity-title" class="account-page__panel-title" tabindex="-1">Add activity</h2>
                        <p class="account-page__section-hint">Add a blog post, video, package, talk or anything else that isn't on your profile yet. Paste the link and we fill in what we can. It shows on your profile right away; moderators may remove anything that doesn't belong.</p>
                        <dc-profile-activity-editor></dc-profile-activity-editor>
                    </section>
                }

                <section id="feeds" class="account-page__panel" data-account-panel aria-labelledby="account-panel-feeds-title">
                    <h2 id="account-panel-feeds-title" class="account-page__panel-title" tabindex="-1">Feeds &amp; links</h2>

                    <section class="account-page__section">
                        <h3 class="account-page__section-title">Your feeds</h3>
                        <p class="account-page__section-hint">Manage the blogs and social profiles that feed your public profile.</p>
                        <dc-feed-manager></dc-feed-manager>
                    </section>

                    @if (Model.CanMatchLinks)
                    {
                        <section class="account-page__section">
                            <h3 class="account-page__section-title">Links we found for you</h3>
                            <p class="account-page__section-hint">These accounts and feeds look like yours. Add the ones that are, and tell us about any that aren't.</p>
                            <dc-link-suggestions></dc-link-suggestions>
                        </section>
                    }
                </section>

                @if (showBadges)
                {
                    <section id="badges" class="account-page__panel" data-account-panel aria-labelledby="account-panel-badges-title">
                        <h2 id="account-panel-badges-title" class="account-page__panel-title" tabindex="-1">Forum badges</h2>
                        <p class="account-page__section-hint">Show the badges you've earned on the Umbraco forum on your profile, under your links.</p>
                        <dc-profile-badges-editor></dc-profile-badges-editor>
                    </section>
                }

                @if (Model.MvpBadgeYear is { } mvpBadgeYear)
                {
                    <section id="mvp-badge" class="account-page__panel account-page__mvp-badge" data-account-panel aria-labelledby="account-panel-mvp-badge-title">
                        <h2 id="account-panel-mvp-badge-title" class="account-page__panel-title" tabindex="-1">Your Umbraco MVP @mvpBadgeYear badge</h2>
                        <div class="account-page__mvp-badge-body">
                            <img class="account-page__mvp-badge-image" src="@Model.MvpBadgeImageUrl" alt="" width="120" height="120" loading="lazy" />
                            <div>
                                <p class="account-page__section-hint">
                                    A verifiable Open Badge for your MVP year. The image carries the badge details, so sites that support Open Badges can check it was issued to you. It shows as expired once your @mvpBadgeYear MVP year is over.
                                </p>
                                <p class="account-page__section-hint">
                                    To show it on Sessionize, open your profile, choose Edit, go to Badges and upload the PNG.
                                </p>
                                <a class="btn is-blue" href="@Model.MvpBadgeDownloadUrl" download>Download Umbraco MVP @mvpBadgeYear badge (PNG)</a>
                            </div>
                        </div>
                    </section>
                }
            </div>
        </dc-account-nav>
    </article>
</div>
